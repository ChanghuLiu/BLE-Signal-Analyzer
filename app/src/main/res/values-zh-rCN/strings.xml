    <string name="privacy_intro">BLE Signal Analyzer 扫描用户的 Android 设备可见的 Bluetooth Low Energy 设备。 Bluetooth 扫描在设备本地进行。</string>
    <string name="privacy_app_does_not">该应用程序不会：</string>
    <string name="privacy_no_accounts">创建用户帐户</string>
    <string name="privacy_no_login">需要登录</string>
    <string name="privacy_no_personal_info">收集个人信息</string>
    <string name="privacy_no_scan_upload">上传BLE扫描结果</string>
    <string name="privacy_no_address_upload">上传设备地址</string>
    <string name="privacy_no_server_history">将 BLE 扫描历史记录存储在服务器上</string>
    <string name="privacy_no_ads">使用广告服务</string>
    <string name="privacy_no_analytics">使用分析服务</string>
    <string name="privacy_no_sale">出售或共享用户数据</string>
    <string name="privacy_memory_intro">应用程序运行时，会在内存中临时处理以下 BLE 设备信息：</string>
    <string name="privacy_device_name">设备名称</string>
    <string name="privacy_signal_strength">信号强度</string>
    <string name="privacy_manufacturer_data">制造商数据</string>
    <string name="privacy_service_uuids">服务 UUIDs</string>
    <string name="privacy_device_address">设备地址</string>
    <string name="privacy_tx_power">Tx Power</string>
    <string name="privacy_settings_intro">用户偏好设置存储在设备本地。应用设置使用 Android DataStore，语言选择使用 Android 的单应用语言功能。这些设置包括：</string>
    <string name="privacy_theme">主题</string>
    <string name="privacy_scan_duration">扫描持续时间</string>
    <string name="privacy_minimum_rssi">最低 RSSI</string>
    <string name="privacy_signal_preferences">信号显示首选项</string>
    <string name="privacy_alert_threshold">警报阈值</string>
    <string name="privacy_language_preference">语言偏好</string>
    <string name="privacy_permission_prompt_state">该应用程序还存储一个本地标志，指示是否已请求 Bluetooth 权限。这可以防止重复的自动权限提示。</string>
    <string name="privacy_storage_summary">不使用后端服务器或云服务。 BLE 扫描历史记录不会永久存储。</string>
    <string name="privacy_permissions">Bluetooth权限仅用于提供BLE扫描和信号分析。在 Android 11 及更早版本上，Android 可能需要位置权限才能进行 BLE 扫描。 BLE Signal Analyzer 仅因为此平台要求而请求该权限，并且不会派生或存储用户的位置。</string>
    <string name="support_contact">支持/联系</string>
    <string name="rssi_explanation">Bluetooth 信号强度使用 RSSI（接收信号强度指示器）进行测量。 RSSI 在 dBm 中测量。接近于零的值通常意味着接收到的信号更强。</string>
    <string name="example_readings">近似读数</string>
    <string name="reading_very_strong">−40 dBm — 非常强</string>
    <string name="reading_good">−60 dBm — 好</string>
    <string name="reading_weak">−80 dBm — 弱</string>
    <string name="not_exact_distance_heading">RSSI 不是精确的距离测量</string>
    <string name="not_exact_distance_body">设备硬件和周围环境可能会显着改变RSSI。比较相对变化，而不是将读数视为物理距离。</string>
