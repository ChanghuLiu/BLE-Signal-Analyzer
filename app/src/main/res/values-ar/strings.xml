    <string name="privacy_no_personal_info">جمع المعلومات الشخصية</string>
    <string name="privacy_no_scan_upload">تحميل نتائج الفحص BLE</string>
    <string name="privacy_no_address_upload">تحميل عناوين الأجهزة</string>
    <string name="privacy_no_server_history">قم بتخزين سجل المسح BLE على الخادم</string>
    <string name="privacy_no_ads">استخدام الخدمات الإعلانية</string>
    <string name="privacy_no_analytics">استخدم خدمات التحليلات</string>
    <string name="privacy_no_sale">بيع أو مشاركة بيانات المستخدم</string>
    <string name="privacy_memory_intro">تتم معالجة معلومات جهاز BLE التالية مؤقتًا في الذاكرة أثناء تشغيل التطبيق:</string>
