    <string name="privacy_memory_intro">Die folgenden BLE-Geräteinformationen werden vorübergehend im Speicher verarbeitet, während die App ausgeführt wird:</string>
    <string name="privacy_device_name">Gerätename</string>
    <string name="privacy_signal_strength">Signalstärke</string>
    <string name="privacy_manufacturer_data">Herstellerdaten</string>
    <string name="privacy_service_uuids">Dienst UUIDs</string>
