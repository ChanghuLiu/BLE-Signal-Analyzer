    <string name="privacy_intro">BLE Signal Analyzer escanea los dispositivos Bluetooth Low Energy visibles para el dispositivo Android del usuario. El escaneo Bluetooth se produce localmente en el dispositivo.</string>
    <string name="privacy_app_does_not">La aplicación no:</string>
    <string name="privacy_no_accounts">Crear cuentas de usuario</string>
    <string name="privacy_no_login">Requerir inicio de sesión</string>
    <string name="privacy_no_personal_info">Recopilar información personal</string>
    <string name="privacy_no_scan_upload">Cargue los resultados del escaneo BLE</string>
    <string name="privacy_no_address_upload">Cargar direcciones de dispositivos</string>
    <string name="privacy_no_server_history">Almacene el historial de escaneo BLE en un servidor</string>
    <string name="privacy_no_ads">Utilice servicios de publicidad.</string>
    <string name="privacy_no_analytics">Utilice servicios de análisis</string>
    <string name="privacy_no_sale">Vender o compartir datos de usuario</string>
    <string name="privacy_memory_intro">La siguiente información del dispositivo BLE se procesa temporalmente en la memoria mientras se ejecuta la aplicación:</string>
    <string name="privacy_device_name">Nombre del dispositivo</string>
    <string name="privacy_signal_strength">Fuerza de la señal</string>
    <string name="privacy_manufacturer_data">Datos del fabricante</string>
    <string name="privacy_service_uuids">Servicio UUIDs</string>
    <string name="privacy_device_address">Dirección del dispositivo</string>
    <string name="privacy_tx_power">Tx Power</string>
    <string name="privacy_settings_intro">Las preferencias se almacenan localmente en el dispositivo. Los ajustes usan Android DataStore y el idioma usa la función de idioma por aplicación de Android. Incluyen:</string>
    <string name="privacy_theme">Tema</string>
    <string name="privacy_scan_duration">Duración del escaneo</string>
    <string name="privacy_minimum_rssi">Mínimo RSSI</string>
    <string name="privacy_signal_preferences">Preferencias de visualización de señal</string>
    <string name="privacy_alert_threshold">Umbral de alerta</string>
    <string name="privacy_language_preference">Preferencia de idioma</string>
    <string name="privacy_permission_prompt_state">La aplicación también almacena una bandera local que indica si ya se ha solicitado el permiso Bluetooth. Esto evita repetidas solicitudes de permiso automáticas.</string>
    <string name="privacy_storage_summary">No se utiliza ningún servidor backend ni servicio en la nube. El historial de escaneo de BLE no se almacena permanentemente.</string>
    <string name="privacy_permissions">Los permisos Bluetooth se utilizan únicamente para proporcionar escaneo y análisis de señales BLE. En Android 11 y versiones anteriores, Android puede requerir permiso de ubicación para escanear BLE. BLE Signal Analyzer solicita ese permiso solo debido a este requisito de plataforma y no deriva ni almacena la ubicación del usuario.</string>
    <string name="support_contact">Soporte / Contacto</string>
    <string name="rssi_explanation">La intensidad de la señal Bluetooth se mide utilizando RSSI (indicador de intensidad de la señal recibida). RSSI se mide en dBm. Un valor más cercano a cero normalmente significa una señal recibida más fuerte.</string>
    <string name="example_readings">Lecturas aproximadas</string>
    <string name="reading_very_strong">−40 dBm — Muy fuerte</string>
    <string name="reading_good">−60 dBm — Bueno</string>
    <string name="reading_weak">−80 dBm - Débil</string>
    <string name="not_exact_distance_heading">RSSI no es una medida de distancia exacta</string>
    <string name="not_exact_distance_body">El hardware del dispositivo y el entorno circundante pueden cambiar RSSI significativamente. Compare cambios relativos en lugar de tratar una lectura como una distancia física.</string>
    <string name="signal_affected_by">La intensidad de la señal puede verse afectada por:</string>
