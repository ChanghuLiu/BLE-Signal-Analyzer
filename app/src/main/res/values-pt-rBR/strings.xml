    <string name="privacy_intro">BLE Signal Analyzer verifica dispositivos Bluetooth Low Energy visíveis para o dispositivo Android do usuário. A verificação Bluetooth ocorre localmente no dispositivo.</string>
    <string name="privacy_app_does_not">O aplicativo não:</string>
    <string name="privacy_no_accounts">Criar contas de usuário</string>
    <string name="privacy_no_login">Exigir login</string>
    <string name="privacy_no_personal_info">Colete informações pessoais</string>
    <string name="privacy_no_scan_upload">Carregar resultados da verificação BLE</string>
    <string name="privacy_no_address_upload">Carregar endereços de dispositivos</string>
    <string name="privacy_no_server_history">Armazene o histórico de varredura BLE em um servidor</string>
    <string name="privacy_no_ads">Use serviços de publicidade</string>
    <string name="privacy_no_analytics">Use serviços de análise</string>
    <string name="privacy_no_sale">Venda ou compartilhe dados do usuário</string>
    <string name="privacy_memory_intro">As seguintes informações do dispositivo BLE são processadas temporariamente na memória enquanto o aplicativo está em execução:</string>
    <string name="privacy_device_name">Nome do dispositivo</string>
    <string name="privacy_signal_strength">Força do sinal</string>
    <string name="privacy_manufacturer_data">Dados do fabricante</string>
    <string name="privacy_service_uuids">Serviço UUIDs</string>
    <string name="privacy_device_address">Endereço do dispositivo</string>
    <string name="privacy_tx_power">Tx Power</string>
    <string name="privacy_settings_intro">As preferências são armazenadas localmente no dispositivo. As configurações usam Android DataStore, e o idioma usa o suporte de idioma por aplicativo do Android. Elas incluem:</string>
    <string name="privacy_theme">Tema</string>
    <string name="privacy_scan_duration">Duração da verificação</string>
    <string name="privacy_minimum_rssi">Mínimo RSSI</string>
    <string name="privacy_signal_preferences">Preferências de exibição de sinal</string>
    <string name="privacy_alert_threshold">Limite de alerta</string>
    <string name="privacy_language_preference">Preferência de idioma</string>
    <string name="privacy_permission_prompt_state">O aplicativo também armazena um sinalizador local indicando se a permissão Bluetooth já foi solicitada. Isso evita solicitações repetidas de permissão automática.</string>
    <string name="privacy_storage_summary">Nenhum servidor back-end ou serviço de nuvem é usado. O histórico de varredura BLE não é armazenado permanentemente.</string>
    <string name="privacy_permissions">As permissões Bluetooth são usadas apenas para fornecer varredura BLE e análise de sinal. No Android 11 e versões anteriores, Android pode exigir permissão de localização para digitalização BLE. BLE Signal Analyzer solicita essa permissão apenas devido a este requisito da plataforma e não deriva ou armazena a localização do usuário.</string>
    <string name="support_contact">Suporte / Contato</string>
    <string name="rssi_explanation">A intensidade do sinal Bluetooth é medida usando RSSI (Indicador de intensidade do sinal recebido). RSSI é medido em dBm. Um valor mais próximo de zero geralmente significa um sinal recebido mais forte.</string>
    <string name="example_readings">Leituras aproximadas</string>
    <string name="reading_very_strong">−40 dBm — Muito forte</string>
    <string name="reading_good">−60 dBm – Bom</string>
    <string name="reading_weak">−80 dBm – Fraco</string>
    <string name="not_exact_distance_heading">RSSI não é uma medida de distância exata</string>
    <string name="not_exact_distance_body">O hardware do dispositivo e o ambiente circundante podem alterar RSSI significativamente. Compare as mudanças relativas em vez de tratar uma leitura como uma distância física.</string>
    <string name="signal_affected_by">A intensidade do sinal pode ser afetada por:</string>
