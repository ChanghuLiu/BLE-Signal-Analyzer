    <string name="privacy_intro">BLE Signal Analyzer 掃描使用者的 Android 裝置可見的 Bluetooth Low Energy 裝置。 Bluetooth 掃描在設備本地進行。</string>
    <string name="privacy_app_does_not">該應用程式不會：</string>
    <string name="privacy_no_accounts">建立使用者帳戶</string>
    <string name="privacy_no_login">需要登入</string>
    <string name="privacy_no_personal_info">收集個人資訊</string>
    <string name="privacy_no_scan_upload">上傳BLE掃描結果</string>
    <string name="privacy_no_address_upload">上傳設備位址</string>
    <string name="privacy_no_server_history">將 BLE 掃描記錄儲存在伺服器上</string>
    <string name="privacy_no_ads">使用廣告服務</string>
    <string name="privacy_no_analytics">使用分析服務</string>
    <string name="privacy_no_sale">出售或共享用戶數據</string>
    <string name="privacy_memory_intro">應用程式執行時，會在記憶體中暫時處理以下 BLE 裝置資訊：</string>
    <string name="privacy_device_name">設備名稱</string>
    <string name="privacy_signal_strength">訊號強度</string>
    <string name="privacy_manufacturer_data">製造商數據</string>
    <string name="privacy_service_uuids">服務 UUIDs</string>
    <string name="privacy_device_address">設備位址</string>
    <string name="privacy_tx_power">Tx Power</string>
    <string name="privacy_settings_intro">使用者偏好設定儲存在裝置本機。應用程式設定使用 Android DataStore，語言選擇使用 Android 的單一應用程式語言功能。這些設定包括：</string>
    <string name="privacy_theme">主題</string>
    <string name="privacy_scan_duration">掃描持續時間</string>
    <string name="privacy_minimum_rssi">最低 RSSI</string>
    <string name="privacy_signal_preferences">訊號顯示首選項</string>
    <string name="privacy_alert_threshold">警報閾值</string>
    <string name="privacy_language_preference">語言偏好</string>
    <string name="privacy_permission_prompt_state">該應用程式還儲存一個本機標誌，指示是否已要求 Bluetooth 權限。這可以防止重複的自動權限提示。</string>
    <string name="privacy_storage_summary">不使用後端伺服器或雲端服務。 BLE 掃描記錄不會永久儲存。</string>
    <string name="privacy_permissions">Bluetooth權限僅用於提供BLE掃描和訊號分析。在 Android 11 及更早版本上，Android 可能需要位置權限才能進行 BLE 掃描。 BLE Signal Analyzer 僅因為此平台要求而請求該權限，並且不會衍生或儲存使用者的位置。</string>
    <string name="support_contact">支持/聯繫</string>
    <string name="rssi_explanation">Bluetooth 訊號強度使用 RSSI（接收訊號強度指示器）進行測量。 RSSI 在 dBm 中測量。接近零的值通常意味著接收到的訊號更強。</string>
    <string name="example_readings">近似讀數</string>
    <string name="reading_very_strong">−40 dBm — 非常強</string>
    <string name="reading_good">−60 dBm — 好</string>
    <string name="reading_weak">−80 dBm — 弱</string>
    <string name="not_exact_distance_heading">RSSI 不是精確的距離測量</string>
    <string name="not_exact_distance_body">設備硬體和周圍環境可能會顯著改變RSSI。比較相對變化，而不是將讀數視為物理距離。</string>
    <string name="signal_affected_by">訊號強度可能受以下因素影響：</string>
    <string name="factor_walls">牆壁</string>
    <string name="factor_furniture">家具</string>
    <string name="factor_people">人</string>
    <string name="factor_orientation">設備方向</string>
