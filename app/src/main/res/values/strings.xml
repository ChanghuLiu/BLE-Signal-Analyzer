    <string name="privacy_intro">BLE Signal Analyzer scans Bluetooth Low Energy devices visible to the user’s Android device. Bluetooth scanning occurs locally on the device.</string>
    <string name="privacy_app_does_not">The app does not:</string>
    <string name="privacy_no_accounts">Create user accounts</string>
    <string name="privacy_no_login">Require login</string>
    <string name="privacy_no_personal_info">Collect personal information</string>
    <string name="privacy_no_scan_upload">Upload BLE scan results</string>
    <string name="privacy_no_address_upload">Upload device addresses</string>
    <string name="privacy_no_server_history">Store BLE scan history on a server</string>
    <string name="privacy_no_ads">Use advertising services</string>
    <string name="privacy_no_analytics">Use analytics services</string>
    <string name="privacy_no_sale">Sell or share user data</string>
    <string name="privacy_memory_intro">The following BLE device information is processed temporarily in memory while the app is running:</string>
    <string name="privacy_device_name">Device name</string>
    <string name="privacy_signal_strength">Signal strength</string>
    <string name="privacy_manufacturer_data">Manufacturer data</string>
    <string name="privacy_service_uuids">Service UUIDs</string>
    <string name="privacy_device_address">Device address</string>
    <string name="privacy_tx_power">Tx Power</string>
    <string name="privacy_settings_intro">User preferences are stored locally on the device. App settings use Android DataStore, while the language choice uses Android’s per-app language support. These preferences include:</string>
    <string name="privacy_theme">Theme</string>
    <string name="privacy_scan_duration">Scan duration</string>
    <string name="privacy_minimum_rssi">Minimum RSSI</string>
    <string name="privacy_signal_preferences">Signal display preferences</string>
    <string name="privacy_alert_threshold">Alert threshold</string>
    <string name="privacy_language_preference">Language preference</string>
    <string name="privacy_permission_prompt_state">The app also stores a local flag indicating whether Bluetooth permission has already been requested. This prevents repeated automatic permission prompts.</string>
    <string name="privacy_storage_summary">No backend server or cloud service is used. BLE scan history is not permanently stored.</string>
    <string name="privacy_permissions">Bluetooth permissions are used only to provide BLE scanning and signal analysis. On Android 11 and earlier, Android may require location permission for BLE scanning. BLE Signal Analyzer requests that permission only because of this platform requirement and does not derive or store the user’s location.</string>
    <string name="support_contact">Support / Contact</string>

    <string name="rssi_explanation">Bluetooth signal strength is measured using RSSI (Received Signal Strength Indicator). RSSI is measured in dBm. A value closer to zero usually means a stronger received signal.</string>
    <string name="example_readings">Approximate readings</string>
    <string name="reading_very_strong">−40 dBm — Very strong</string>
    <string name="reading_good">−60 dBm — Good</string>
    <string name="reading_weak">−80 dBm — Weak</string>
    <string name="not_exact_distance_heading">RSSI is not an exact distance measurement</string>
    <string name="not_exact_distance_body">Device hardware and the surrounding environment can change RSSI significantly. Compare relative changes instead of treating a reading as a physical distance.</string>
