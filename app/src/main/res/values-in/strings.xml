    <string name="reading_good">−60 dBm — Bagus</string>
    <string name="reading_weak">−80 dBm — Lemah</string>
    <string name="not_exact_distance_heading">RSSI bukanlah pengukuran jarak yang tepat</string>
    <string name="not_exact_distance_body">Perangkat keras perangkat dan lingkungan sekitar dapat mengubah RSSI secara signifikan. Bandingkan perubahan relatif daripada memperlakukan pembacaan sebagai jarak fisik.</string>
