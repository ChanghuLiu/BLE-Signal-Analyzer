    <string name="privacy_no_scan_upload">Unggah hasil pemindaian BLE</string>
    <string name="privacy_no_address_upload">Unggah alamat perangkat</string>
    <string name="privacy_no_server_history">Simpan riwayat pemindaian BLE di server</string>
    <string name="privacy_no_ads">Gunakan layanan periklanan</string>
    <string name="privacy_no_analytics">Gunakan layanan analitik</string>
    <string name="privacy_no_sale">Jual atau bagikan data pengguna</string>
    <string name="privacy_memory_intro">Informasi perangkat BLE berikut diproses sementara di memori saat aplikasi berjalan:</string>
    <string name="privacy_device_name">Nama perangkat</string>
    <string name="privacy_signal_strength">Kekuatan sinyal</string>
