    <string name="privacy_no_personal_info">Kişisel bilgileri topla</string>
    <string name="privacy_no_scan_upload">BLE tarama sonuçlarını yükleyin</string>
    <string name="privacy_no_address_upload">Cihaz adreslerini yükle</string>
    <string name="privacy_no_server_history">BLE tarama geçmişini bir sunucuda saklayın</string>
