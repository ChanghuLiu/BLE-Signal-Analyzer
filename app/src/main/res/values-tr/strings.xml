    <string name="privacy_no_analytics">Analiz hizmetlerini kullanın</string>
    <string name="privacy_no_sale">Kullanıcı verilerini sat veya paylaş</string>
    <string name="privacy_memory_intro">Aşağıdaki BLE cihaz bilgileri, uygulama çalışırken geçici olarak bellekte işlenir:</string>
    <string name="privacy_device_name">Cihaz adı</string>
    <string name="privacy_signal_strength">Sinyal gücü</string>
